# Salesforce org credentials used by the auth setup project (tests/setup/auth.setup.ts)
SF_BASE_URL=https://login.salesforce.com
SF_USERNAME=your-dev-org-username@example.com
SF_PASSWORD=your-password
SF_SECURITY_TOKEN=

# Where the authenticated browser storage state is cached between runs
STORAGE_STATE_PATH=playwright/.auth/user.json

# Email OTP automation - see README "Handling Email Verification Code on Login"
OTP_AUTOMATION_ENABLED=true
OTP_IMAP_HOST=imap.gmail.com
OTP_IMAP_PORT=993
OTP_IMAP_USER=your-test-inbox@gmail.com
OTP_IMAP_PASSWORD=your-app-specific-password
OTP_POLL_TIMEOUT_MS=60000
OTP_POLL_INTERVAL_MS=3000
